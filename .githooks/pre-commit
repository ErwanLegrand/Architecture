#!/bin/sh
# Doc-integrity gate. Activate once per clone with:
#   git config core.hooksPath .githooks
# Bypass in an emergency with: git commit --no-verify
set -eu

cd "$(git rev-parse --show-toplevel)"
fail=0

# 1. The per-type index files must be regenerated after any frontmatter change.
if ! python3 tools/gen-index.py --check; then
  fail=1
fi

# 2. Body Markdown links resolve (paths are space-free; decode any stray %20).
broken=$(grep -rhoE '\]\(/[^)]+\)' --include='*.md' . \
  | sed -E 's/^\]\(\/(.*)\)$/\1/; s/%20/ /g' \
  | while IFS= read -r p; do [ -e "$p" ] || echo "BROKEN: $p"; done)
if [ -n "$broken" ]; then
  printf '%s\n' "$broken"
  fail=1
fi

# 3. Every frontmatter [[wikilink]] relation target resolves to a file.
unresolved=$(grep -rhoE '\[\[[^]]+\]\]' --include='*.md' \
  "principles" "patterns" "primitives" "threats" "references" \
  | sed -E 's/\[\[(.*)\]\]/\1/' | sort -u \
  | while IFS= read -r id; do find . -name "$id.md" | grep -q . || echo "UNRESOLVED: [[$id]]"; done)
if [ -n "$unresolved" ]; then
  printf '%s\n' "$unresolved"
  fail=1
fi

# 4. No forbidden verb is used as a relation key.
if grep -rnE '^(affects|uses|helps):' --include='*.md' \
  "principles" "patterns" "primitives" "threats" "references"; then
  echo "^ FORBIDDEN relation verb"
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: doc-integrity checks failed (see above)." >&2
  exit 1
fi
